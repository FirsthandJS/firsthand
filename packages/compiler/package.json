{
  "name": "@firsthandjs/compiler",
  "version": "0.12.2",
  "description": "Build-time TSX transform for Firsthand: static markup into templates, dynamic expressions into DOM parts.",
  "license": "MIT",
  "author": "IgorAnowsky",
  "scripts": {
    "test": "vitest run --root ../.. packages/compiler/test"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@babel/core": "^8.0.9",
    "@babel/plugin-syntax-jsx": "^8.0.0",
    "@babel/types": "^8.0.6",
    "@babel/plugin-syntax-typescript": "^8.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firsthandjs/firsthand.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/firsthandjs/firsthand/issues"
  },
  "homepage": "https://github.com/firsthandjs/firsthand#readme",
  "keywords": [
    "reactive",
    "signals",
    "fine-grained",
    "web-components",
    "ui",
    "framework",
    "jsx",
    "no-virtual-dom"
  ]
}
