{
  "name": "@firsthandjs/react",
  "version": "0.6.2",
  "description": "Render React components inside Firsthand, for component libraries like MUI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/auto.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@firsthandjs/core": "0.6.2",
    "@firsthandjs/dom": "0.6.2"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firsthandjs/firsthand.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/firsthandjs/firsthand/issues"
  },
  "homepage": "https://github.com/firsthandjs/firsthand#readme",
  "keywords": [
    "firsthand",
    "react",
    "interop",
    "mui",
    "adapter"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  }
}
