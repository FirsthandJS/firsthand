{
  "name": "firsthand-storybook-integration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Storybook running against Firsthand components, as proof that it does.",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build --output-dir dist --quiet",
    "test": "tsc --noEmit && node verify.mjs"
  },
  "dependencies": {
    "@firsthandjs/dom": "file:../../packages/dom",
    "@firsthandjs/jsx-runtime": "file:../../packages/jsx-runtime",
    "@firsthandjs/query": "file:../../packages/query",
    "@firsthandjs/router": "file:../../packages/router"
  },
  "devDependencies": {
    "@firsthandjs/compiler": "file:../../packages/compiler",
    "@storybook/html-vite": "^9.1.10",
    "storybook": "^9.1.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@vitest/mocker": "^4.1.11"
  }
}
